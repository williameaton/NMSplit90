    subroutine copy_allstrain_to_device(astrain, ModeLs, ngll, nspec)
        use params, only: max_tl1, nmodes, myrank
        implicit none 
        ! IO variables
        integer :: ngll, nspec
        complex(kind=SPLINE_REAL) :: astrain(ngll, ngll, ngll, nspec, max_tl1, 6, nmodes)
        integer :: modeLs(nmodes)


        real(kind=8),  dimension(ngll*ngll*ngll, nspec, max_tl1, 6) :: strains_real
        real(kind=8),  dimension(ngll*ngll*ngll, nspec, max_tl1, 6) :: strains_imag
        ! Local: 
        integer :: i,j,k,l,m,p,imode,ispec,igll

        d_allstrains_r = 0.0_8   ! Zero these
        d_allstrains_i = 0.0_8   ! Zero these

        do imode = 1, nmodes
            strains_real = zero 
            strains_imag = zero 

            do ispec = 1, nspec 
                igll = 1
                do i = 1, ngll
                    do j = 1, ngll 
                        do k = 1, ngll
                            do m = 1, 2*modeLs(imode) + 1 
                                do p = 1, 6
                                    strains_real(igll, ispec, m, p) =  real(astrain(i,j,k,ispec, m, p, imode))
                                    strains_imag(igll, ispec, m, p) = aimag(astrain(i,j,k,ispec, m, p, imode))
                                enddo 
                            enddo 
                            igll = igll + 1
                        enddo 
                    enddo 
                enddo 
            enddo 


            ! Copy to device
            d_allstrains_r(:,:,:,:, imode) = strains_real
            d_allstrains_i(:,:,:,:, imode) = strains_imag
        enddo !imodes 
            
    end subroutine







    subroutine compute_Vani_onemode_allstrains(imode, l, ngll, nspec)
        use params, only: vani, myrank, max_tl1
        implicit none 
        ! IO variables
        integer :: ngll, nspec, imode
        integer :: l,  tl1

        ! Local host variables
        real(kind=8) :: Vloc_r(max_tl1 , max_tl1), Vloc_i(max_tl1, max_tl1), tmp
        integer :: upper_diag_elem, ii, jj, success
        integer :: start_clock, end_clock, count_rate
        real(8) :: elapsed_time


        ! Zero the matrices on the GPU 
        d_vani_real_G = 0.0_8
        d_vani_imag_G = 0.0_8

        tl1 = 2*l + 1
        upper_diag_elem = (tl1+1)*tl1/2

        ! Copy off device to CPU: 
        if(ngll.eq.5)then
                call vani_knl_allstrains<<<dim3(nspec,tl1,tl1), dim3(ngll*ngll*ngll,1,1)>>>(imode, tl1, nspec)               
        else 
            write(*,*)'Error. hardcoded for ngll = 5'
            stop
        endif 

        success = cudaMemcpy(Vloc_r,         & 
                             d_vani_real_G,  &
                             max_tl1 * max_tl1, cudaMemcpyDeviceToHost)
   

        success = cudaMemcpy(Vloc_i,         & 
                             d_vani_imag_G,  &
                             max_tl1 * max_tl1, cudaMemcpyDeviceToHost)

        ! Add the real and imaginary components to the global Vani
        Vani(1:tl1, 1:tl1) = Vani(1:tl1, 1:tl1) + Vloc_r(1:tl1, 1:tl1) + SPLINE_iONE*Vloc_i(1:tl1, 1:tl1)
    end subroutine compute_Vani_onemode_allstrains





    attributes(global) subroutine vani_knl_allstrains(imode, tl1, nspec)
        integer, value  :: imode, tl1, nspec

        ! internal variables
        integer         :: i, j, k, ispec, m1, m2, p, q, istat, igll
        real(kind=8) :: cont_r, cont_i
        real(kind=8)    :: trash
        integer, dimension(9), parameter :: Vcont = (/1, 2, 3, 4, 4, 5, 5, 6, 6/)

        ! In shared memory: 
        !real, dimension(125,6), shared :: s_strain_1_real, s_strain_2_real
        !real, dimension(125,6), shared :: s_strain_1_imag, s_strain_2_imag
        !real, dimension(125,6,6), shared:: s_c

        igll = threadidx%x
        if(igll.gt.125)return 

        ispec = blockidx%x
        m1    = blockidx%y
        m2    = blockidx%z

        ! Copy some stuff to close shared memory
        !s_strain_1_real(igll, :) = d_strains_real(igll, ispec, m1, :)
        !s_strain_2_real(igll, :) = d_strains_real(igll, ispec, m2, :)

        !s_strain_1_imag(igll, :) = d_strains_imag(igll, ispec, m1, :)
        !s_strain_2_imag(igll, :) = d_strains_imag(igll, ispec, m2, :)
        !s_c(igll, :, :)    = d_Cxyz(igll, ispec, :, :)


        cont_r = 0.0_8
        cont_i = 0.0_8
                

        do p = 1, 9
            do q =1,9
                ! Real part 
                cont_r = cont_r  +  (d_allstrains_r(igll, ispec, m1, Vcont(p),imode) * d_allstrains_r(igll, ispec, m2, Vcont(q),imode)  + & 
                                     d_allstrains_i(igll, ispec, m1, Vcont(p),imode) * d_allstrains_i(igll, ispec, m2, Vcont(q),imode)) * & 
                                     d_Cxyz_g(igll, ispec, Vcont(p), Vcont(q))

                ! Imag part 
                cont_i = cont_i  +  (d_allstrains_r(igll, ispec, m1, Vcont(p),imode) * d_allstrains_i(igll, ispec, m2, Vcont(q),imode)  - & 
                                     d_allstrains_r(igll, ispec, m2, Vcont(q),imode) * d_allstrains_i(igll, ispec, m1, Vcont(p),imode)) * & 
                                     d_Cxyz_g(igll, ispec, Vcont(p), Vcont(q))
                enddo 
        enddo 


        cont_r = cont_r * d_wglljac_g(igll,ispec)
        cont_i = cont_i * d_wglljac_g(igll,ispec)

        ! Extract the real and imaginary parts: 
        ! atomic add not available for complex. 

        trash = atomicadd(d_vani_real_G(m1, m2),  cont_r)
        trash = atomicadd(d_vani_imag_G(m1, m2),  cont_i)
        
        call syncthreads()
        
    end subroutine vani_knl_allstrains



    subroutine check_cuda_device_allocations(nprocs)
        use params, only: myrank
        implicit none 
        integer :: nprocs
        integer :: err, mydevice, devcount, mydev, nsets_per_gpu

        ! Number of devices
        err = cudaGetDeviceCount(devcount)

        ! even split across the GPUs: 
        nsets_per_gpu = CEILING(real(nprocs)/real(devcount))

        mydev = FLOOR(real(myrank)/real(nsets_per_gpu))


        err = cudaSetDevice(mydev)
        
        err = cudaGetDevice(mydevice)
        write(*,*)'myrank = ', myrank, ' my GPU device = ',  mydevice


    end subroutine check_cuda_device_allocations




    subroutine cuda_project_eta_to_GLL(model_npoints, nspec, ngll)
        ! Launches cuda kernel to project the 3D model onto the 
        ! GLL mesh by a nearest neighbour search
        ! If there are N gll points to be evaulated and M points that
        ! could be the nearest neighbour then N threads will be launched
        ! where each thread will evaluate M options 
        implicit none 
        integer :: model_npoints, nspec, ngll

        call project_eta_to_gll<<<dim3(nspec, 1, 1), dim3(ngll, ngll, ngll)>>>(model_npoints, ngll)               

    end subroutine cuda_project_eta_to_GLL


    attributes(global) subroutine project_eta_to_gll(npoints, ngll)
    integer, value  :: npoints, ngll

    ! internal variables
    integer         :: mypt, i,j,k,l, igllx, iglly, igllz, ispec
    real(kind=8)    :: cont_r, cont_i
    real(kind=8)    :: dist, last_dist, rad2, rho, vp, vs, myx, myy, myz
    real(kind=8)    :: myA, myC, myL, myN, myF
    real(kind=8)    :: Cnat(6,6), Q(6,6), Crot(6,6)
    real(kind=8)    :: n1, n2, c1, c2, s1, s2, r11, r12, r13, r21, r22, r23, r31, r32, r33

    igllx = threadidx%x
    iglly = threadidx%y
    igllz = threadidx%z

    ispec = blockidx%x

    myx = d_xcoord(igllx,iglly,igllz,ispec)
    myy = d_ycoord(igllx,iglly,igllz,ispec)
    myz = d_zcoord(igllx,iglly,igllz,ispec)

    ! For each possible point let us evaluate the distance
    last_dist = 1000.0d0
    do ipt = 1, npoints
        dist = ( (Model3D_dev(ipt,1)-myx )**2.0d0 + & 
                 (Model3D_dev(ipt,2)-myy )**2.0d0 + & 
                 (Model3D_dev(ipt,3)-myz )**2.0d0)**0.5d0 
        ! If distance is smaller than last then save this index 
        if(dist.lt.last_dist)then 
            last_dist = dist
            mypt      = ipt 
        endif 
    enddo 

    ! Ultimately we set this points eta 1 and eta 2 to the final mypt 
    ! that survived: 
    n1 = Model3D_dev(mypt,4)
    n2 = Model3D_dev(mypt,5)
    d_eta1(igllx,iglly,igllz,ispec) = n1
    d_eta2(igllx,iglly,igllz,ispec) = n2


    ! Get the PREM related values for ACLNF at this point: 
    rad2 = d_rad(igllx,iglly,igllz,ispec)**two


    ! Originally g/cm^3 --> kg/m^3 -> nondimensionalised
    rho = (13.0885d0 - 8.8381d0*rad2)*0.1813466804490d0   ! 1000.d0/RHOAV
    ! Originally km/s --> m/s  
    vp  = (11.2622d0 - 6.3640d0*rad2)*0.1459938230354d0   ! 1000.d0/SCALE_V
    vs  = (3.6678d0 - 4.4475d0*rad2)*0.1459938230354d0    ! 1000.d0/SCALE_V

    myA = rho * vp * vp * Model_ACLNF(1)
    myC = rho * vp * vp * Model_ACLNF(2)
    myL = rho * vs * vs * Model_ACLNF(3)
    myN = rho * vs * vs * Model_ACLNF(4)
    ! eta  = 1 for PREM core and F = eta * (A - 2L)
    myF = ((rho * vp * vp) - 2.0d0*(rho * vs * vs)) * Model_ACLNF(5) 


    ! Create natural Stiffness matrix:
    Cnat(:,:) = 0.0d0 
    Cnat(1,1) = myA 
    Cnat(2,2) = myA 
    Cnat(3,3) = myC 
    Cnat(4,4) = myL 
    Cnat(5,5) = myL 
    Cnat(6,6) = myN 

    Cnat(1,2) = myA - 2.0d0*myN
    Cnat(2,1) = myA - 2.0d0*myN

    Cnat(1,3) = myF
    Cnat(3,1) = myF
    Cnat(2,3) = myF
    Cnat(3,2) = myF

    ! Create bond matrix: 
    c1 = cos(n1)
    c2 = cos(n2)
    s1 = sin(n1)
    s2 = sin(n2)

    ! Eqn 5 of Brett 2024
    r11 = c1 * c2 
    r12 = - s1
    r13 = c1*s2
    
    r21 = s1*c2
    r22 = c1
    r23 = s1*s2 

    r31 = -s2
    r32 = zero
    r33 = c2


    ! Eqn 8 of Brett 2024
    ! r11 = c1 * c2 
    ! r12 = s1 * c2
    ! r13 = -s2 

    ! r21 = -s1 
    ! r22 = c1 
    ! r23 = zero 

    ! r31 = c1*s2
    ! r32 = s1*s2
    ! r33 = c2


    Q(1,1) = r11 * r11 
    Q(2,1) = r21 * r21 
    Q(3,1) = r31 * r31
    Q(4,1) = r21*r31
    Q(5,1) = r31*r11
    Q(6,1) = r11*r21

    Q(1,2) = r12 * r12
    Q(2,2) = r22 * r22
    Q(3,2) = r32 * r32
    Q(4,2) = r22*r32
    Q(5,2) = r32*r12
    Q(6,2) = r12*r22

    Q(1,3) = r13*r13
    Q(2,3) = r23*r23
    Q(3,3) = r33*r33
    Q(4,3) = r23*r33
    Q(5,3) = r33*r13
    Q(6,3) = r13*r23

    Q(1,4) = 2.0d0*r12*r13
    Q(2,4) = 2.0d0*r22*r23
    Q(3,4) = 2.0d0*r32*r33
    Q(4,4) = r22*r33 + r32*r23
    Q(5,4) = r12*r33 + r13*r32
    Q(6,4) = r12*r23 + r13*r22

    Q(1,5) = 2.0d0 * r11 * r13
    Q(2,5) = 2.0d0 * r21 * r23
    Q(3,5) = 2.0d0 * r33 * r31
    Q(4,5) = r23*r31 + r21*r33
    Q(5,5) = r33*r11 +r13*r31
    Q(6,5) = r13*r21 + r23*r11

    Q(1,6) = 2.0d0 * r11 * r12
    Q(2,6) = 2.0d0 * r21 * r22
    Q(3,6) = 2.0d0 * r31 * r32
    Q(4,6) = r21*r32 + r31*r22
    Q(5,6) = r31*r12 + r11*r32
    Q(6,6) = r11*r22 + r21*r12

    ! Compute Bond * C * Bond^T
    ! C'_il =  B_ij C_jk B_lk  note transpose on last matrix
    Crot(:,:) = 0.0d0 
    do i = 1,6
        do l = 1,6
            do j = 1,6
                do k = 1,6
                    Crot(i,l) = Crot(i,l) +  (Q(i,j) * Cnat(j,k) * Q(l,k))
                enddo 
            enddo 
        enddo
    enddo 

    ! convert this i,j,k,nspec to ngll^3 x nspec and store:
    d_Cxyz_g(ngll*ngll*(igllx-1) + ngll*(iglly-1) + igllz, ispec , :, :) = Crot


    end subroutine project_eta_to_gll




end module vani_kernel